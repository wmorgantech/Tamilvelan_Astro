generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  mobile        String          @unique
  passwordHash  String
  isAdmin       Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  birthProfiles BirthProfile[]
  consultations Consultation[]
  matches       MarriageMatch[]
  payments      Payment[]
  reports       Report[]
}

model BirthProfile {
  id         String           @id @default(uuid())
  userId     String
  fullName   String
  dob        DateTime
  birthTime  String
  birthPlace String
  latitude   Float
  longitude  Float
  isDefault  Boolean          @default(false)
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id])
  charts     HoroscopeChart[]
}

model HoroscopeChart {
  id          String       @id @default(uuid())
  profileId   String
  rasi        String
  lagna       String
  nakshatra   String
  dashaLord   String
  dashaEnd    DateTime?
  planetsJson Json
  generatedAt DateTime     @default(now())
  profile     BirthProfile @relation(fields: [profileId], references: [id])
}

model MarriageMatch {
  id              String   @id @default(uuid())
  userId          String
  brideName       String
  brideDob        DateTime
  brideBirthTime  String
  brideBirthPlace String
  groomName       String
  groomDob        DateTime
  groomBirthTime  String
  groomBirthPlace String
  porutthamJson   Json
  totalScore      Int
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}

model Report {
  id        String   @id @default(uuid())
  userId    String
  type      String
  fileUrl   String?
  paid      Boolean  @default(false)
  amount    Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Astrologer {
  id             String         @id @default(uuid())
  name           String
  specialization String
  experienceYrs  Int
  ratePerHour    Int
  bio            String?
  photoUrl       String?
  available      Boolean        @default(true)
  consultations  Consultation[]
}

model Consultation {
  id           String     @id @default(uuid())
  userId       String
  astrologerId String
  date         DateTime
  timeSlot     String
  status       String     @default("PENDING")
  paymentId    String?
  createdAt    DateTime   @default(now())
  astrologer   Astrologer @relation(fields: [astrologerId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
}

model Payment {
  id              String   @id @default(uuid())
  userId          String
  razorpayOrderId String?
  amount          Int
  currency        String   @default("INR")
  status          String   @default("PENDING")
  purpose         String
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}

model PanchangCache {
  id              String   @id @default(uuid())
  date            DateTime @unique
  tithi           String
  nakshatra       String
  yoga            String
  karana          String
  varam           String
  rahuKalam       String
  yamagandam      String
  shubhaMuhurtham String?
  festivalsJson   Json?
  createdAt       DateTime @default(now())
}
